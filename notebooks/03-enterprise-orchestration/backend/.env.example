# AWS Region
AWS_REGION=us-west-2

# Tutorial 01 - RAG Agent (Unstructured Data with Metadata Filtering)
RAG_COGNITO_USER_POOL_ID=us-west-2_xxxxx
RAG_COGNITO_CLIENT_ID=xxxxx
RAG_AGENT_ARN=arn:aws:bedrock-agentcore:us-west-2:123456789:runtime/unstructured_multitenant_rag-xxxxx

# Tutorial 02 - RLS Agent (Structured Data with Row-Level Security)
RLS_COGNITO_USER_POOL_ID=us-west-2_xxxxx
RLS_COGNITO_CLIENT_ID=xxxxx
RLS_AGENT_ARN=arn:aws:bedrock-agentcore:us-west-2:123456789:runtime/structured_multitenant_rls-xxxxx

# Demo Settings (for local development only)
DEMO_PASSWORD=Pass123!
FLASK_DEBUG=false
